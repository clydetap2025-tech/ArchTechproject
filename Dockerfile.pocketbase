FROM alpine:3.23 AS download

ARG TARGETARCH
ARG POCKETBASE_VERSION=0.40.6
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) checksum=0e1f609158ed945f809f8a02ae012aa0427129c66ebb63c1aee76f2c0309373f ;; \
      arm64) checksum=d22c66ceb67ca92b7d767f36d826e848a276bcfa3c197ead20bf87c42208984f ;; \
      *) exit 1 ;; \
    esac; \
    name="pocketbase_${POCKETBASE_VERSION}_linux_${TARGETARCH}.zip"; \
    wget -qO /tmp/pocketbase.zip "https://github.com/pocketbase/pocketbase/releases/download/v${POCKETBASE_VERSION}/${name}"; \
    echo "$checksum  /tmp/pocketbase.zip" | sha256sum -c -; \
    unzip -q /tmp/pocketbase.zip pocketbase -d /tmp

FROM alpine:3.23
RUN apk add --no-cache ca-certificates
COPY --from=download --chmod=0755 /tmp/pocketbase /usr/local/bin/pocketbase
COPY pb_migrations/ /app/pb_migrations/
COPY pb_hooks/ /app/pb_hooks/
WORKDIR /app
ENV PORT=8090
ENV DIARY_ORIGIN=https://archtechproject.vercel.app
EXPOSE 8090
VOLUME ["/pb_data"]
CMD ["/bin/sh", "-ec", "if [ -n \"${RAILWAY_ENVIRONMENT_ID:-}\" ]; then : \"${RAILWAY_VOLUME_MOUNT_PATH:?Attach a persistent volume to this service}\"; fi; exec pocketbase serve --http=\"0.0.0.0:$PORT\" --dir=\"${RAILWAY_VOLUME_MOUNT_PATH:-/pb_data}\" --migrationsDir=/app/pb_migrations --hooksDir=/app/pb_hooks --automigrate=false --origins=\"$DIARY_ORIGIN\""]
